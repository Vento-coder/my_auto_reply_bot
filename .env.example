# my.telegram.org -> API development tools
# Bu qiymatlarni o'zingiz kiriting; hech kimga yubormang.
API_ID=123456
API_HASH=your_api_hash_here

# Telegram Bot Token (@BotFather dan oling)
BOT_TOKEN=your_bot_token_here

# Encryption key (sessionlarni shifrlash uchun, random string yaratish tavsiya etiladi)
ENCRYPTION_KEY=your_random_encryption_key_here

# Database URL (SQLite uchun: sqlite:///userbot.db, PostgreSQL uchun: postgresql://user:password@localhost/dbname)
DB_URL=sqlite:///userbot.db

# Owner ID (admin uchun Telegram user ID)
OWNER_ID=123456789
